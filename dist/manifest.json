{
  "manifest_version": 3,
  "name": "JSON Dialect",
  "version": "1.3.0",
  "description": "Python 字面量与 Java/标准 JSON 双向转换，纯本地、容错优先",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "JSON Dialect"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}