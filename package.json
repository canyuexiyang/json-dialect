{
  "name": "json-dialect",
  "version": "1.7.2",
  "private": true,
  "description": "Python 字面量 / JSON / Java 转义串 / Map.toString() 四向转换的纯本地 Chrome 扩展（MV3）",
  "type": "module",
  "scripts": {
    "build": "vite build && node tools/copy-manifest.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:prop": "vitest run tests/prop",
    "test:ac": "vitest run tests/acceptance",
    "verify:python": "python3 tools/verify_with_python.py",
    "bench": "vitest run tests/bench --reporter=basic",
    "check:privacy": "node tools/check-privacy.mjs",
    "notices": "node tools/gen-third-party-notices.mjs",
    "check:notices": "node tools/gen-third-party-notices.mjs --check",
    "typecheck": "tsc --noEmit",
    "verify:all": "npm run typecheck && npm run check:notices && npm run test && npm run verify:python && npm run build && npm run check:privacy",
    "verify:ui": "node tools/v14-verify.mjs"
  },
  "keywords": [
    "chrome-extension",
    "json",
    "python"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "fast-check": "^3.23.2",
    "jsdom": "^30.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15"
  }
}
